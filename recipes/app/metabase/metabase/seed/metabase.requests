POST /api/database db:northstar {"engine":"postgres","name":"Northstar Relay","details":{"host":"@companion:host@","port":"@companion:port@","dbname":"@companion:database@","user":"@companion:username@","password":"@companion:password@","ssl":false,"tunnel-enabled":false,"schema-filters-type":"inclusion","schema-filters-patterns":"northstar"},"is_full_sync":true}
POST /api/dataset - {"type":"native","native":{"query":"SELECT 1 AS ok;\nCREATE SCHEMA IF NOT EXISTS northstar;\nCREATE TABLE IF NOT EXISTS northstar.customers (\n  customer_id   text PRIMARY KEY,\n  name          text NOT NULL,\n  plan          text NOT NULL,\n  monthly_usd   numeric(10,2) NOT NULL,\n  contact_name  text NOT NULL,\n  contact_email text NOT NULL,\n  customer_since date NOT NULL,\n  status        text NOT NULL\n);\nCREATE TABLE IF NOT EXISTS northstar.invoices (\n  invoice_number text PRIMARY KEY,\n  customer_id    text NOT NULL,\n  customer_name  text NOT NULL,\n  description    text NOT NULL,\n  issued_on      date NOT NULL,\n  due_on         date NOT NULL,\n  amount_usd     numeric(10,2) NOT NULL,\n  status         text NOT NULL,\n  paid_on        date\n);\nCREATE TABLE IF NOT EXISTS northstar.supplier_bills (\n  bill_id      text PRIMARY KEY,\n  supplier     text NOT NULL,\n  description  text NOT NULL,\n  issued_on    date NOT NULL,\n  amount_usd   numeric(10,2) NOT NULL,\n  status       text NOT NULL\n);\nCREATE TABLE IF NOT EXISTS northstar.export_runs (\n  run_id         integer PRIMARY KEY,\n  started_at     timestamp NOT NULL,\n  customer_id    text NOT NULL,\n  customer_name  text NOT NULL,\n  run_mode       text NOT NULL,\n  row_count      integer NOT NULL,\n  duration_s     numeric(6,1) NOT NULL,\n  status         text NOT NULL,\n  failure_reason text\n);\nCREATE TABLE IF NOT EXISTS northstar.support_cases (\n  case_id       text PRIMARY KEY,\n  opened_at     timestamp NOT NULL,\n  customer_name text NOT NULL,\n  title         text NOT NULL,\n  priority      text NOT NULL,\n  state         text NOT NULL,\n  owner         text NOT NULL,\n  next_action   text NOT NULL\n)","template-tags":{}},"database":"@db:northstar@"}
