POST /api/database/@db:northstar@/sync_schema - {}
POST /api/collection collection:ops {"name":"Operations","description":"Exports, customers, and the August books.","parent_id":null}
POST /api/card card:runs-30d {"name":"Exports run in the last 30 days","description":"Every scheduled and interactive export run, counted over the most recent 30 days of data.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT count(*) AS \"Runs\"\nFROM northstar.export_runs\nWHERE started_at >= (SELECT max(started_at) FROM northstar.export_runs) - interval '30 days'","template-tags":{}},"database":"@db:northstar@"},"display":"scalar","visualization_settings":{"scalar.field":"Runs"}}
POST /api/card card:failures-30d {"name":"Scheduled exports that timed out","description":"Scheduled runs stopped by the 120-second worker limit in the most recent 30 days.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT count(*) AS \"Timed out\"\nFROM northstar.export_runs\nWHERE run_mode = 'scheduled' AND status = 'failed'\n  AND started_at >= (SELECT max(started_at) FROM northstar.export_runs) - interval '30 days'","template-tags":{}},"database":"@db:northstar@"},"display":"scalar","visualization_settings":{"scalar.field":"Timed out"}}
POST /api/card card:mrr {"name":"Monthly recurring revenue","description":"The sum of every active subscription.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT sum(monthly_usd) AS \"MRR\"\nFROM northstar.customers\nWHERE status = 'active'","template-tags":{}},"database":"@db:northstar@"},"display":"scalar","visualization_settings":{"scalar.field":"MRR","column_settings":{"[\"name\",\"MRR\"]":{"number_style":"currency","currency":"USD","currency_in_header":false}}}}
POST /api/card card:open-invoices {"name":"Open invoice balance","description":"Everything invoiced and not yet paid.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT coalesce(sum(amount_usd), 0) AS \"Open balance\"\nFROM northstar.invoices\nWHERE status <> 'paid'","template-tags":{}},"database":"@db:northstar@"},"display":"scalar","visualization_settings":{"scalar.field":"Open balance","column_settings":{"[\"name\",\"Open balance\"]":{"number_style":"currency","currency":"USD","currency_in_header":false}}}}
POST /api/card card:outcomes-by-week {"name":"Scheduled export outcomes by week","description":"When the 120-second worker limit started stopping scheduled runs.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT date_trunc('week', started_at)::date AS \"Week\",\n       count(*) FILTER (WHERE status = 'succeeded') AS \"Succeeded\",\n       count(*) FILTER (WHERE status = 'failed') AS \"Timed out\"\nFROM northstar.export_runs\nWHERE run_mode = 'scheduled'\n  AND started_at >= (SELECT max(started_at) FROM northstar.export_runs) - interval '84 days'\nGROUP BY 1\nORDER BY 1","template-tags":{}},"database":"@db:northstar@"},"display":"bar","visualization_settings":{"graph.dimensions":["Week"],"graph.metrics":["Succeeded","Timed out"],"stackable.stack_type":"stacked","graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Week","graph.y_axis.title_text":"Scheduled runs"}}
POST /api/card card:lumen-rows {"name":"Lumen Labs rows per scheduled export","description":"Usage against the row count where a scheduled run reaches the worker limit.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT date_trunc('day', started_at)::date AS \"Day\",\n       max(row_count) AS \"Rows exported\",\n       52184 AS \"Worker limit\"\nFROM northstar.export_runs\nWHERE customer_id = 'lumen' AND run_mode = 'scheduled'\nGROUP BY 1\nORDER BY 1","template-tags":{}},"database":"@db:northstar@"},"display":"line","visualization_settings":{"graph.dimensions":["Day"],"graph.metrics":["Rows exported","Worker limit"],"graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Day","graph.y_axis.title_text":"Rows"}}
POST /api/card card:runs-by-customer {"name":"Export runs by customer","description":"How each account's runs finished over the most recent 30 days of data.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT customer_name AS \"Customer\",\n       count(*) FILTER (WHERE status = 'succeeded') AS \"Succeeded\",\n       count(*) FILTER (WHERE status = 'failed') AS \"Timed out\",\n       count(*) FILTER (WHERE status = 'cancelled') AS \"Cancelled\"\nFROM northstar.export_runs\nWHERE started_at >= (SELECT max(started_at) FROM northstar.export_runs) - interval '30 days'\nGROUP BY 1\nORDER BY 2 DESC","template-tags":{}},"database":"@db:northstar@"},"display":"bar","visualization_settings":{"graph.dimensions":["Customer"],"graph.metrics":["Succeeded","Timed out","Cancelled"],"stackable.stack_type":"stacked","graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Customer","graph.y_axis.title_text":"Runs"}}
POST /api/card card:duration-vs-rows {"name":"Export duration against row count","description":"Where the cost of an export stops being a straight line.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT row_count AS \"Rows\",\n       duration_s AS \"Seconds\",\n       run_mode AS \"Run mode\"\nFROM northstar.export_runs\nWHERE status <> 'cancelled'\n  AND started_at >= (SELECT max(started_at) FROM northstar.export_runs) - interval '60 days'\nORDER BY row_count","template-tags":{}},"database":"@db:northstar@"},"display":"scatter","visualization_settings":{"graph.dimensions":["Rows","Run mode"],"graph.metrics":["Seconds"],"graph.x_axis.title_text":"Rows","graph.y_axis.title_text":"Seconds"}}
POST /api/card card:rows-by-customer {"name":"Export rows by customer, by month","description":"How much data each account is moving, and how fast that is changing.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT date_trunc('month', started_at)::date AS \"Month\",\n       customer_name AS \"Customer\",\n       sum(row_count) AS \"Rows exported\"\nFROM northstar.export_runs\nWHERE started_at < date_trunc('month', (SELECT max(started_at) FROM northstar.export_runs))\n  AND started_at >= date_trunc('month', (SELECT min(started_at) FROM northstar.export_runs))\n      + interval '1 month'\nGROUP BY 1, 2\nORDER BY 1","template-tags":{}},"database":"@db:northstar@"},"display":"bar","visualization_settings":{"graph.dimensions":["Month","Customer"],"graph.metrics":["Rows exported"],"stackable.stack_type":"stacked","graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Month","graph.y_axis.title_text":"Rows"}}
POST /api/card card:invoiced-by-month {"name":"Invoiced by month","description":"Subscription billing over the last twelve complete months.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT date_trunc('month', issued_on)::date AS \"Month\",\n       customer_name AS \"Customer\",\n       sum(amount_usd) AS \"Invoiced\"\nFROM northstar.invoices\nWHERE issued_on < date_trunc('month', (SELECT max(issued_on) FROM northstar.invoices))\nGROUP BY 1, 2\nORDER BY 1","template-tags":{}},"database":"@db:northstar@"},"display":"bar","visualization_settings":{"graph.dimensions":["Month","Customer"],"graph.metrics":["Invoiced"],"stackable.stack_type":"stacked","graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Month","graph.y_axis.title_text":"Invoiced (USD)"}}
POST /api/card card:revenue-vs-cost {"name":"Invoiced against supplier costs","description":"What the company billed each complete month next to what it paid out.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"WITH billed AS (\n  SELECT date_trunc('month', issued_on)::date AS month, sum(amount_usd) AS invoiced\n  FROM northstar.invoices\n  WHERE issued_on < date_trunc('month', (SELECT max(issued_on) FROM northstar.invoices))\n  GROUP BY 1\n), spent AS (\n  SELECT date_trunc('month', issued_on)::date AS month, sum(amount_usd) AS supplier_cost\n  FROM northstar.supplier_bills GROUP BY 1\n)\nSELECT billed.month AS \"Month\",\n       billed.invoiced AS \"Invoiced\",\n       coalesce(spent.supplier_cost, 0) AS \"Supplier costs\"\nFROM billed LEFT JOIN spent ON spent.month = billed.month\nORDER BY 1","template-tags":{}},"database":"@db:northstar@"},"display":"bar","visualization_settings":{"graph.dimensions":["Month"],"graph.metrics":["Invoiced","Supplier costs"],"graph.y_axis.auto_split":false,"graph.x_axis.title_text":"Month","graph.y_axis.title_text":"USD"}}
POST /api/card card:open-cases {"name":"Open support cases","description":"The cases support is carrying right now.","collection_id":"@collection:ops@","dataset_query":{"type":"native","native":{"query":"SELECT opened_at::date AS \"Opened\",\n       customer_name AS \"Customer\",\n       title AS \"Case\",\n       priority AS \"Priority\",\n       state AS \"State\",\n       owner AS \"Owner\",\n       next_action AS \"Next action\"\nFROM northstar.support_cases\nORDER BY opened_at","template-tags":{}},"database":"@db:northstar@"},"display":"table","visualization_settings":{}}
POST /api/dashboard dashboard:ops {"name":"Northstar Relay operations","description":"Exports, the accounts behind them, and the August books.","collection_id":"@collection:ops@"}
PUT /api/dashboard/@dashboard:ops@ - {"dashcards":[{"id":-1,"card_id":"@card:runs-30d@","row":0,"col":0,"size_x":6,"size_y":3,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-2,"card_id":"@card:failures-30d@","row":0,"col":6,"size_x":6,"size_y":3,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-3,"card_id":"@card:mrr@","row":0,"col":12,"size_x":6,"size_y":3,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-4,"card_id":"@card:open-invoices@","row":0,"col":18,"size_x":6,"size_y":3,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-5,"card_id":"@card:outcomes-by-week@","row":3,"col":0,"size_x":12,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-6,"card_id":"@card:lumen-rows@","row":3,"col":12,"size_x":12,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-7,"card_id":"@card:runs-by-customer@","row":10,"col":0,"size_x":8,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-8,"card_id":"@card:duration-vs-rows@","row":10,"col":8,"size_x":8,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-9,"card_id":"@card:rows-by-customer@","row":10,"col":16,"size_x":8,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-10,"card_id":"@card:invoiced-by-month@","row":17,"col":0,"size_x":12,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-11,"card_id":"@card:revenue-vs-cost@","row":17,"col":12,"size_x":12,"size_y":7,"series":[],"parameter_mappings":[],"visualization_settings":{}},{"id":-12,"card_id":"@card:open-cases@","row":24,"col":0,"size_x":24,"size_y":5,"series":[],"parameter_mappings":[],"visualization_settings":{}}]}
